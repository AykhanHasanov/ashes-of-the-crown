; Engine configuration file.
; Godot 4.7 — Ashes of the Crown

config_version=5

[application]

config/name="Ashes of the Crown"
config/description="Kül Gecəsindən sonra Atəşan səltənəti."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

DataDB="*res://scripts/core/data_db.gd"
Settings="*res://scripts/systems/settings.gd"
Memory="*res://scripts/systems/memory_system.gd"
GameState="*res://scripts/systems/game_state.gd"
Fx="*res://scripts/systems/fx.gd"
Audio="*res://scripts/systems/audio.gd"
Barks="*res://scripts/systems/barks.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"

[shader_globals]

player_position={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
wind_strength={
"type": "float",
"value": 0.5
}
foliage_density={
"type": "float",
"value": 1.0
}
window_light={
"type": "float",
"value": 0.0
}
